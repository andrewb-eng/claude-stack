{
  "_comment": "Work-laptop Claude Code settings. MERGE into ~/.claude/settings.json — do not blind-copy over an existing file. Replace YOURNAME in every path with your username (echo $HOME on macOS/Linux, echo $env:USERPROFILE on Windows). On Windows, swap the //Users/YOURNAME prefixes for //C:/Users/YOURNAME.",

  "model": "opus",

  "permissions": {
    "deny": [
      "Read(//Users/YOURNAME/.ssh/**)",
      "Read(//Users/YOURNAME/.gnupg/**)",
      "Read(//Users/YOURNAME/.aws/**)",
      "Read(//Users/YOURNAME/.azure/**)",
      "Read(//Users/YOURNAME/.kube/**)",
      "Read(//Users/YOURNAME/.docker/config.json)",
      "Read(//Users/YOURNAME/.git-credentials)",
      "Read(//Users/YOURNAME/.npmrc)",
      "Read(//Users/YOURNAME/.pypirc)",
      "Read(//Users/YOURNAME/.nuget/**)",
      "Read(//Users/YOURNAME/.config/gh/**)",
      "Read(//Users/YOURNAME/Library/Keychains/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/appsettings.Production.json)",
      "Read(**/appsettings.*.local.json)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/service-account*.json)",
      "Read(**/credentials.json)",
      "Read(**/*secret*.json)",
      "Read(**/*.key)",

      "Edit(//Users/YOURNAME/.zshrc)",
      "Edit(//Users/YOURNAME/.zshenv)",
      "Edit(//Users/YOURNAME/.zprofile)",
      "Edit(//Users/YOURNAME/.bashrc)",
      "Edit(//Users/YOURNAME/.bash_profile)",
      "Edit(//Users/YOURNAME/.profile)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/appsettings.Production.json)",

      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(iwr * | iex)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(sudo *)"
    ],

    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx vitest run*)",
      "Bash(node -c *)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet format --verify-no-changes*)",
      "Bash(python3 -m py_compile *)",
      "Bash(python3 -m json.tool)",
      "Bash(pytest*)",
      "Bash(ruff check*)"
    ]
  },

  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "github@claude-plugins-official": true
  }
}
